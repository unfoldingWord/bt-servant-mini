<?xml version="1.0" encoding="UTF-8"?>
<!-- Export for TestFlight: signed with unfoldingWord's account through the App Store Connect API key (cloud-managed
     certificate, automatic profiles) and uploaded by xcodebuild itself. CI adds teamID from the APPLE_TEAM_ID secret. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
