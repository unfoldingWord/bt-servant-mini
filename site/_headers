# The installable web app runs the model with several threads, which needs a cross-origin isolated page.
/app/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# The Android app reads this from its own page (https://appassets.androidplatform.net): a cross-origin GET, no credentials.
/latest.json
  Access-Control-Allow-Origin: *
  Cache-Control: no-cache
